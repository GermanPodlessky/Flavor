<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Nullable>enable</Nullable>
        <LangVersion>12.0</LangVersion>

        <PackageId>Flavor.AspNetCore</PackageId>
        <Version>1.0.0</Version>
        <Authors>German Podlessky and Contributors</Authors>
        <Description>ASP.NET Core integration for Flavor HTML to PDF converter. Includes PdfResult, Razor view rendering, and DI extensions.</Description>
        <PackageTags>pdf;html;converter;html-to-pdf;aspnetcore;razor;mvc</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/GermanPodlessky/Flavor</PackageProjectUrl>
        <RepositoryUrl>https://github.com/GermanPodlessky/Flavor</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flavor\Flavor.csproj"/>
    </ItemGroup>

</Project>
